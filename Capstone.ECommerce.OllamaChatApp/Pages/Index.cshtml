@page
@model IndexModel
@{
    ViewData["Title"] = "TGA Capstone Ollama Chat";
}

<link href="https://fonts.googleapis.com/css2?family=Roboto&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>

<div class="chat-container">
    <div class="chat-header">TGA Capstone Ollama Chat</div>
    <div class="chat-messages" id="notificationsList">
        <div class="message user">Hello, AI!</div>
        <div class="message assistant">Hey there, human! What's on your mind? 😊</div>
    </div>
    <div class="chat-input">
        <input type="text" id="notificationInput" placeholder="Ask AI Assistant..." />
        <button id="sendNotificationButton">Send</button>
    </div>
</div>